<?xml version="1.0"?>
<robot name="hoverboard_robot" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="macros.xacro" />
    <xacro:include filename="wheels.xacro" />
    <xacro:include filename="ros2_control.xacro" />

    <xacro:property name="plate_radius" value="0.225" />
    <xacro:property name="plate_height" value="0.01" />

    <xacro:property name="chassis_weight" value="1.0" />

    <xacro:property name="driving_wheel_diameter" value="0.17" />
    <xacro:property name="driving_wheel_thickness" value="0.045" />
    <xacro:property name="driving_wheel_weight" value="2.2" />
    <xacro:property name="driving_wheel_base_gap" value="0.01" />

    <xacro:property name="caster_wheel_diameter" value="0.04" />
    <xacro:property name="caster_wheel_weight" value="0.1" />

    <link name="base_link">
    </link>

    <link name="base_footprint">
    </link>

    

    <link name="plate">
        <visual>
            <origin xyz="0 0 0.06" rpy="0 0 3.14"/>
            <geometry>
                <mesh filename="package://hoverboard_demo_description/meshes/plate.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.06" rpy="0 0 3.14"/>
            <geometry>
               <mesh filename="package://hoverboard_demo_description/meshes/plate.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${plate_radius}" h="${plate_height}" roll="${pi/2}"/>
    </link>
    
    <link name="default_cam">
     <visual>
            <origin xyz="-0.105 0.015 0.11" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://hoverboard_demo_description/meshes/default_cam.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="-0.105 0.015 0.11" rpy="0 0 0"/>
            <geometry>
               <mesh filename="package://hoverboard_demo_description/meshes/default_cam.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>
    
    <link name="imu_1">
  <inertial>
    <origin xyz="-1.1999536222984447e-05 -9.133494040338212e-05 0.0008621646654776854" rpy="0 0 0"/>
    <mass value="0.00499712942650714"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.071" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/imu_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.071" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/imu_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="driver_1">
  <inertial>
    <origin xyz="-0.08835000994870672 -0.0006931558000162142 0.01645048758441489" rpy="0 0 0"/>
    <mass value="0.6142590344888996"/>
    <inertia ixx="0.000918" iyy="0.000455" izz="0.001328" ixy="1.7e-05" iyz="4e-06" ixz="6e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.071" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/driver_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.071" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/driver_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="pc_1">
  <inertial>
    <origin xyz="0.0 0.0 0.02109885707652978" rpy="0 0 0"/>
    <mass value="9.924188790786896"/>
    <inertia ixx="0.025961" iyy="0.026752" izz="0.049864" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.152" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/pc_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="dark"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.152" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/pc_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="laser">
  <inertial>
    <origin xyz="0.00829409957031958 0.0 0.031201142222790967" rpy="0 0 0"/>
    <mass value="1.151561654231425"/>
    <inertia ixx="0.000489" iyy="0.000861" izz="0.000987" ixy="-0.0" iyz="-0.0" ixz="0.000148"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.194" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.194" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="top_plate_1">
  <inertial>
    <origin xyz="0.06 0.105 0.002999999999999975" rpy="0 0 0"/>
    <mass value="2.3338049999999986"/>
    <inertia ixx="0.011967" iyy="0.007665" izz="0.019619" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.06 0.105 -0.146" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/top_plate_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.06 0.105 -0.146" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hoverboard_demo_description)/meshes/top_plate_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>


<joint name="base_link_plate_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="plate" />
</joint>

<joint name="base_link_cam_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="default_cam" />
</joint>
    
<joint name="base_link_print_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="base_footprint" />
</joint>


<joint name="imu_joint" type="fixed">
  <origin xyz="0.0 0.0 0.061" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="imu_1"/>
</joint>

<joint name="board_joint" type="fixed">
  <origin xyz="0.0 0.0 0.061" rpy="0 0 0"/>
  <parent link="plate"/>
  <child link="driver_1"/>
</joint>

<joint name="pc_joint" type="fixed">
  <origin xyz="0.06 0.105 0.075" rpy="0 0 0"/>
  <parent link="top_plate_1"/>
  <child link="pc_1"/>
</joint>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.042" rpy="0 0 0"/>
  <parent link="pc_1"/>
  <child link="laser"/>
</joint>


<joint name="top_cover_joint" type="fixed">
  <origin xyz="-0.06 -0.105 0.07" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="top_plate_1"/>
</joint>





    <xacro:driving_wheel suffix="left" reflect="1"/>
    <xacro:driving_wheel suffix="right" reflect="-1"/>

    <xacro:caster_wheel suffix="front" reflect="1" />
    <xacro:caster_wheel suffix="back" reflect="-1" />

    <xacro:hoverboard_ros2_control name="Hoverboard" />

</robot>
